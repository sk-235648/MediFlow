# MediFlow Environment Configuration
LLM_PROVIDER=mock # Options: mock, openai, gemini

# Optional: Set API keys if you wish to use live cloud LLMs
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Safety & Refinement Parameters
SAFETY_MAX_RETRY_LOOPS=2
HALLUCINATION_THRESHOLD=0.20
